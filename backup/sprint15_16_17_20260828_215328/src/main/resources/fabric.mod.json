                    "cardinal-components-entity":  "\u003e=5.2.0"
                },
    "recommends":  {
                       "bettercombat":  "\u003e=1.9.0",
                       "geckolib":  "\u003e=4.4.0",
                       "cloth-config":  "\u003e=11.0.0"
