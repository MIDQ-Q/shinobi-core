{
    "schemaVersion":  1,
    "id":  "shinobicore",
    "version":  "${version}",
    "name":  "Shinobi Core",
    "description":  "Full Naruto RPG mod: clans, jutsu, parkour, dojutsu, progression",
    "authors":  [
                    "ShinobiCore Team"
                ],
    "contact":  {

                },
    "license":  "MIT",
    "icon":  "assets/shinobicore/icon.png",
    "environment":  "*",
