                        "cardinal-components":  [
                                                    "com.example.shinobicore.stat.component.NinjaComponentInitializer"
                                                ],
                        "main":  [
                                     "com.example.shinobicore.ShinobiCore",
                                     "com.example.shinobicore.bootstrap.Sprint1Bootstrap",
                                     "com.example.shinobicore.bootstrap.Sprint3Bootstrap",
                                     "com.example.shinobicore.bootstrap.Sprint1314Bootstrap"
                                 ],
                        "client":  [
                                       "com.example.shinobicore.client.vfx.VfxClientBootstrap",
                                       "com.example.shinobicore.ShinobiCoreClient",
                                       "com.example.shinobicore.bootstrap.Sprint2ClientBootstrap",
                                       "com.example.shinobicore.bootstrap.Sprint3ClientBootstrap",
                                       "com.example.shinobicore.bootstrap.Sprint4ClientBootstrap",
                                       "com.example.shinobicore.bootstrap.Sprint12ClientBootstrap",
                                       "com.example.shinobicore.bootstrap.Sprint1314ClientBootstrap"
